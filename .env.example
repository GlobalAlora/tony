# Public site URL — used for canonical tags, OG/Twitter metadata, JSON-LD,
# sitemap.xml, robots.txt and llms.txt. Set this to the real production
# domain once it's live.
NEXT_PUBLIC_SITE_URL=https://tonypiorno.com

# Supabase — Project Settings > API in the Supabase dashboard.
# The ANON key is safe here: the `proposals` table has RLS enabled with an
# INSERT-only policy (see supabase/migrations), so this key can never read,
# edit, or delete existing rows even if exposed.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Resend — resend.com/api-keys. Needs a verified sending domain in
# production (resend.com/domains); onboarding@resend.dev only works for
# sending to your own account email while testing.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL="Tony Piorno <notificaciones@tonypiorno.com>"

# Where new-proposal notifications are delivered. Defaults to
# piornotony@gmail.com if unset.
CREATOR_NOTIFICATION_EMAIL=piornotony@gmail.com

# Meta Graph API — System User access token, used to auto-refresh the
# Instagram follower count shown on the site (see src/lib/instagram/live-stats.ts).
# Generated once from Business Settings > System Users, set to never expire.
# Missing/invalid token just falls back to the static number in
# creator-data.ts — never breaks the page.
META_ACCESS_TOKEN=

# TikTok for Developers — Login Kit app, used to auto-refresh TikTok
# follower/likes/video counts (see src/lib/tiktok/live-stats.ts).
# Get these from developers.tiktok.com under "Manage apps".
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Random secret you make up yourself — required as ?key= on
# /api/tiktok/oauth/start so a random visitor can't trigger the one-time
# TikTok authorization flow. Any long random string works.
TIKTOK_SETUP_SECRET=
